<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.fintrack.controller.LoginController" alignment="CENTER" spacing="14" styleClass="fundo">
 <padding><Insets top="40" right="45" bottom="40" left="45"/></padding>
 <Label text="FinTrack" styleClass="titulo-form"/>
 <Label text="Controle suas finanças de forma simples e segura" wrapText="true"/>
 <TextField fx:id="campoNome" promptText="Nome (somente para criar conta)" maxWidth="360"/>
 <TextField fx:id="campoEmail" promptText="E-mail" maxWidth="360"/>
 <StackPane maxWidth="360">
  <PasswordField fx:id="campoSenha" promptText="Senha (mínimo de 8 caracteres)" maxWidth="360"/>
  <TextField fx:id="campoSenhaVisivel" promptText="Senha (mínimo de 8 caracteres)" maxWidth="360" visible="false" managed="false"/>
 </StackPane>
 <HBox alignment="CENTER" spacing="18" maxWidth="360">
  <CheckBox fx:id="lembrarEmail" text="Lembrar meu e-mail"/>
  <ToggleButton fx:id="botaoMostrarSenha" text="Mostrar senha" onAction="#alternarSenha"/>
 </HBox>
 <Label fx:id="mensagem" textFill="#b42318" wrapText="true" maxWidth="360"/>
 <HBox alignment="CENTER" spacing="10">
  <Button text="Entrar" onAction="#login" styleClass="botao-primario" defaultButton="true"/>
  <Button text="Criar conta" onAction="#registrar"/>
 </HBox>
 <Hyperlink text="Esqueci minha senha" onAction="#abrirRecuperacao"/>
 <Separator maxWidth="360"/>
 <Label text="A recuperação de senha é feita pelo e-mail cadastrado." wrapText="true" maxWidth="360"/>
</VBox>
